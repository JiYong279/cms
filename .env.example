# Copy to .env.local for development, or set these in the hosting dashboard.
# Nothing is required to run locally: without DATABASE_URL the app uses PGlite in .data/.

# --- Database ---------------------------------------------------------------
# Postgres connection string (Neon, Supabase, RDS…). Add ?sslmode=require for hosted databases.
# Required in production. Run `npm run db:migrate` after every deploy that adds a migration.
DATABASE_URL=
# DATABASE_POOL_MAX=5

# --- Docker (docker-compose.yml) ------------------------------------------------
# Password of the cms-postgres container; compose builds DATABASE_URL from it and ignores the one above.
# Use hex (openssl rand -hex 24): it goes into a URL, where characters such as @ / : break it.
POSTGRES_PASSWORD=
# Host port for cms-web (local only; the staging overlay publishes none).
# CMS_PORT=3000

# --- Public address -----------------------------------------------------------
# Where this CMS is reachable, used for image URLs stored on local disk.
CMS_PUBLIC_URL=https://cms.qub-x.com

# --- Websites -----------------------------------------------------------------
# Shared secret sent with every "articles changed" signal. The website must have the same value.
CMS_REVALIDATE_SECRET=
# Protects /api/cron/publish-scheduled. The cms-cron container (docker-compose.vps.yml) sends it as a Bearer token.
CRON_SECRET=

# --- Image storage ------------------------------------------------------------
# Leave empty to keep images on local disk (only for servers with a persistent disk).
#
# DigitalOcean Spaces (production), bucket "my-space" in Singapore:
#   S3_ENDPOINT=https://sgp1.digitaloceanspaces.com  S3_REGION=us-east-1  S3_ACL=public-read
#   S3_PUBLIC_URL=https://my-space.sgp1.cdn.digitaloceanspaces.com  (or without ".cdn" if the CDN is off)
#   S3_PREFIX=cms  keeps the CMS images in their own folder of a shared Space.
# MinIO (local, `docker compose -f docker-compose.minio.yml up -d`):
#   S3_BUCKET=cms  S3_ENDPOINT=http://localhost:9000  S3_REGION=us-east-1  S3_FORCE_PATH_STYLE=true
#   S3_PUBLIC_URL=http://localhost:9000/cms  S3_ACCESS_KEY_ID=minioadmin  S3_SECRET_ACCESS_KEY=minioadmin
# Cloudflare R2: S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com, S3_REGION=auto
S3_BUCKET=
S3_PUBLIC_URL=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# "public-read" for DigitalOcean Spaces and AWS S3 buckets that use ACLs; leave empty for MinIO and R2.
S3_ACL=
# "true" for MinIO.
S3_FORCE_PATH_STYLE=
# Optional folder inside the bucket.
S3_PREFIX=

# --- AI assistant in the editor ----------------------------------------------------
# Anthropic API key (console.anthropic.com). Without it the editor's AI button explains it is off.
ANTHROPIC_API_KEY=
# Claude model for drafts and translations.
AI_MODEL=claude-sonnet-5
# Drafts and translations per person per 24 hours.
AI_DAILY_LIMIT=30

# --- First admin (npm run db:seed) ---------------------------------------------
# Without a password, a random one is generated and printed once.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
